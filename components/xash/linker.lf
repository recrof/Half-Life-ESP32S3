# Static data of the engine and of the game libraries in PSRAM (internal RAM is too small)
[mapping:xash]
archive: libxash.a
entries:
    * (extram_bss)

[mapping:xashlibs]
archive: libxashlibs.a
entries:
    * (extram_bss)
    # the hot code of the renderer in IRAM: the 32 kB instruction cache (shared by the cores)
    # can't hold it, and the misses read the flash
    ref_soft:R_EmitEdge (noflash)
    ref_soft:R_RenderFace (noflash)
    ref_soft:R_LeadingEdge (noflash)
    ref_soft:R_TrailingEdge (noflash)
    ref_soft:R_GenerateSpans (noflash)
    ref_soft:R_ScanEdges (noflash)
    ref_soft:R_ClipEdge (noflash)
    ref_soft:TransformVector (noflash)
    ref_soft:R_RecursiveWorldNode (noflash)
    ref_soft:R_RecursiveClipBPoly (noflash)
    ref_soft:R_DrawSolidClippedSubmodelPolygons (noflash)
    ref_soft:R_DrawSubmodelPolygons (noflash)
    ref_soft:R_RenderBmodelFace (noflash)
    ref_soft:D_DrawSurfaces (noflash)
    ref_soft:D_CacheSurface (noflash)
    ref_soft:D_CalcGradients (noflash)
    ref_soft:D_DrawRecords (noflash)
    ref_soft:D_FlushRecords (noflash)
    ref_soft:D_DrawSpans16St (noflash)
    ref_soft:D_DrawZSpansSt (noflash)
    ref_soft:D_AlphaSpans16 (noflash)
    ref_soft:R_DrawSurface (noflash)
    ref_soft:R_DrawSurfaceBlock8_mip0 (noflash)
    ref_soft:R_DrawSurfaceBlock8_mip1 (noflash)
    ref_soft:R_DrawSurfaceBlock8_mip2 (noflash)
    ref_soft:R_DrawSurfaceBlock8_mip3 (noflash)
    ref_soft:R_StudioDrawPoints (noflash)
    ref_soft:R_StudioComputeBBox (noflash)
    ref_soft:R_LightStrength (noflash)
    ref_soft:R_SetupFinalVert (noflash)
    ref_soft:R_AliasProjectAndClipTestFinalVert (noflash)
    ref_soft:TriBegin (noflash)
    ref_soft:TriEnd (noflash)
    ref_soft:TriVertexProjected (noflash)
    ref_soft:TriVertexProjectedST (noflash)
    ref_soft:R_DrawTriangle (noflash)
    ref_soft:R_RasterizeTriangle (noflash)
    ref_soft:R_FlushTriangles (noflash)
